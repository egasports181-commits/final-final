# ---------------------------------------------------------------
# Upflit environment variables
# Copy this file to ".env" (Windows CMD:  copy .env.example .env)
# ---------------------------------------------------------------

# PostgreSQL connection string (required for saving admin changes).
# Local example (default user/password "postgres", database "app_db"):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Hosted databases (Render, Neon, Supabase) usually need SSL:
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Secret used to sign admin login cookies. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account (only used the very first time, when no admin exists yet).
# If ADMIN_PASSWORD is not set, the default login is admin@upflit.com / upflit-admin
ADMIN_EMAIL=admin@upflit.com
ADMIN_PASSWORD=

# Optional: set to "true" to force SSL even without ?sslmode=require in the URL
# DATABASE_SSL=true

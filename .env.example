# ---------------------------------------------------------------
# Upflit environment variables
# Copy this file to ".env" (Windows CMD:  copy .env.example .env)
# ---------------------------------------------------------------

# PostgreSQL connection string (required for saving admin changes).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign admin login cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account (only used the very first time, when no admin exists yet).
ADMIN_EMAIL=admin@upflit.com
ADMIN_PASSWORD=

# Cloudflare R2 (required for image uploads after R2 integration).
# Create an R2 API token with Object Read & Write access, scoped to the upflit bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=upflit
# Must be a connected and Active R2 custom domain for this bucket.
R2_PUBLIC_URL=https://images.upflit.online
